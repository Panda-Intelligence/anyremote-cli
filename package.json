{
  "name": "@panda-ai/anyremote",
  "version": "0.2.4",
  "description": "Connect a local computer to AnyRemote and expose it through MCP.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Panda-Intelligence/anyremote-cli.git"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "anyremote": "dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./local-tools": "./dist/local-tools.js",
    "./agent": "./dist/agent.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js && bun --cwd packages/contracts test",
    "build": "bun build src/bin.js src/index.js src/local-tools.js src/agent.js --outdir dist --target node --format esm --external open --external sharp",
    "typecheck": "bun --cwd packages/contracts typecheck",
    "lint": "bunx --bun biome check .",
    "prepack": "bun run build",
    "pack:check": "bun pm pack --dry-run"
  },
  "dependencies": {
    "open": "^11.0.4",
    "sharp": "^0.35.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@anyremote/contracts": "workspace:*",
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
